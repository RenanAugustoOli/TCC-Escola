{
  "name": "@academia/api",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/seed.ts",
    "test": "vitest run",
    "vercel-build": "prisma generate --schema=prisma/schema-vercel.prisma && DATABASE_URL=\"file:$PWD/prisma/demo.db\" prisma db push --schema=prisma/schema-vercel.prisma --force-reset --skip-generate && DATABASE_URL=\"file:$PWD/prisma/demo.db\" tsx src/seed-vercel.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.0.1",
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.27.0",
    "mercadopago": "^2.0.6",
    "zod": "^3.23.8"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "prisma": "^5.14.0",
    "tsx": "^4.14.1",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11"
  }
}
