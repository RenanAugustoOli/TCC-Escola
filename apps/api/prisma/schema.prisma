generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PERSONAL_TRAINER
  MEMBER
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  OVERDUE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  BOLETO
}

enum WorkoutDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         UserRole @default(MEMBER)
  avatarUrl    String?
  cpf          String?  @unique
  birthDate    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions         Subscription[]
  workoutLogs           WorkoutLog[]
  personalWorkoutsAsStudent PersonalWorkout[] @relation("StudentPersonalWorkouts")
  personalWorkoutsAsTrainer PersonalWorkout[] @relation("TrainerPersonalWorkouts")
  personalWorkoutLogs   PersonalWorkoutLog[]
}

model Plan {
  id           String   @id @default(cuid())
  name         String
  description  String?
  price        Float
  durationDays Int
  features     String[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
  workouts      PlanWorkout[]
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]
}

model Payment {
  id             String        @id @default(cuid())
  subscriptionId String
  amount         Float
  status         PaymentStatus @default(PENDING)
  method         PaymentMethod
  externalId     String?
  pixQrCode      String?
  pixQrCodeText  String?
  paidAt         DateTime?
  dueDate        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
}

model Workout {
  id              String            @id @default(cuid())
  name            String
  description     String?
  difficulty      WorkoutDifficulty @default(BEGINNER)
  durationMinutes Int
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  exercises   Exercise[]
  plans       PlanWorkout[]
  workoutLogs WorkoutLog[]
}

model Exercise {
  id          String  @id @default(cuid())
  workoutId   String
  name        String
  sets        Int
  reps        String
  restSeconds Int     @default(60)
  notes       String?
  videoUrl    String?
  order       Int     @default(0)

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
}

model PlanWorkout {
  planId    String
  workoutId String

  plan    Plan    @relation(fields: [planId], references: [id])
  workout Workout @relation(fields: [workoutId], references: [id])

  @@id([planId, workoutId])
}

model WorkoutLog {
  id          String   @id @default(cuid())
  userId      String
  workoutId   String
  completedAt DateTime @default(now())
  notes       String?

  user    User    @relation(fields: [userId], references: [id])
  workout Workout @relation(fields: [workoutId], references: [id])
}

// --- Personal Trainer ---

model PersonalWorkout {
  id          String   @id @default(cuid())
  name        String
  description String?
  studentId   String
  trainerId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student   User               @relation("StudentPersonalWorkouts", fields: [studentId], references: [id])
  trainer   User               @relation("TrainerPersonalWorkouts", fields: [trainerId], references: [id])
  exercises PersonalExercise[]
  logs      PersonalWorkoutLog[]
}

model PersonalExercise {
  id               String @id @default(cuid())
  personalWorkoutId String
  name             String
  sets             Int
  reps             String
  restSeconds      Int    @default(60)
  notes            String?
  videoUrl         String?
  order            Int    @default(0)

  personalWorkout PersonalWorkout @relation(fields: [personalWorkoutId], references: [id], onDelete: Cascade)
}

model PersonalWorkoutLog {
  id               String          @id @default(cuid())
  personalWorkoutId String
  studentId        String
  completedAt      DateTime        @default(now())
  notes            String?

  personalWorkout PersonalWorkout @relation(fields: [personalWorkoutId], references: [id])
  student         User            @relation(fields: [studentId], references: [id])
}